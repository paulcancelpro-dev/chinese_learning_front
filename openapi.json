  "components": {
    "schemas": {
      "WordDto": {
        "type": "object",
        "properties": {
          "hanzi": { "type": "string", "maxLength": 100, "minLength": 0 },
          "pinyin": { "type": "string", "maxLength": 200, "minLength": 0 },
          "traductions_fr": {
            "type": "array",
            "items": { "type": "string", "maxLength": 300, "minLength": 0 },
            "maxItems": 30,
            "minItems": 0
          }
        },
        "required": ["hanzi", "pinyin", "traductions_fr"]
      },
      "WordView": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "hanzi": { "type": "string" },
          "pinyin": { "type": "string" },
          "traductions_fr": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      },
      "JsonNode": {
        "type": "object",
        "properties": {
          "number": { "type": "boolean" },
          "floatingPointNumber": { "type": "boolean" },
          "nodeType": {
            "type": "string",
            "enum": [
              "ARRAY",
              "BINARY",
              "BOOLEAN",
              "MISSING",
              "NULL",
              "NUMBER",
              "OBJECT",
              "POJO",
              "STRING"
            ]
          },
          "string": { "type": "boolean" },
          "integralNumber": { "type": "boolean" },
          "missingNode": { "type": "boolean" },
          "valueNode": { "type": "boolean" },
          "container": { "type": "boolean" },
          "pojo": { "type": "boolean" },
          "short": { "type": "boolean" },
          "int": { "type": "boolean" },
          "long": { "type": "boolean" },
          "double": { "type": "boolean" },
          "bigDecimal": { "type": "boolean" },
          "bigInteger": { "type": "boolean" },
          "textual": { "type": "boolean", "deprecated": true },
          "boolean": { "type": "boolean" },
          "binary": { "type": "boolean" },
          "empty": { "type": "boolean" },
          "array": { "type": "boolean" },
          "null": { "type": "boolean" },
          "object": { "type": "boolean" },
          "float": { "type": "boolean" },
          "embeddedValue": { "type": "boolean" }
        }
      },
      "Answer": {
        "type": "object",
        "properties": {
          "answer": { "type": "string", "maxLength": 2000, "minLength": 0 }
        },
        "required": ["answer"]
      },
      "Correction": {
        "type": "object",
        "properties": {
          "exerciseId": { "type": "string", "format": "uuid" },
          "correct": { "type": "boolean" },
          "acceptedAnswers": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string" },
          "answeredAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReuseRequest": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "maximum": 20,
            "minimum": 1
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "HANZI_TO_FRENCH",
                "HANZI_TO_PINYIN",
                "PINYIN_TO_HANZI",
                "MULTIPLE_CHOICE",
                "SENTENCE_TRANSLATION",
                "FILL_IN_THE_BLANK"
              ]
            },
            "maxItems": 2,
            "minItems": 0
          },
          "difficulty": {
            "type": "integer",
            "format": "int32",
            "maximum": 5,
            "minimum": 1
          }
        },
        "required": ["types"]
      },
      "Batch": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "exercises": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ExerciseView" }
          }
        }
      },
      "ExerciseView": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sessionId": { "type": "string", "format": "uuid" },
          "type": {
            "type": "string",
            "enum": [
              "HANZI_TO_FRENCH",
              "HANZI_TO_PINYIN",
              "PINYIN_TO_HANZI",
              "MULTIPLE_CHOICE",
              "SENTENCE_TRANSLATION",
              "FILL_IN_THE_BLANK"
            ]
          },
          "question": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "string" } },
          "difficulty": { "type": "integer", "format": "int32" },
          "newVocabulary": { "type": "array", "items": { "type": "string" } }
        }
      },
      "GenerationRequest": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "maximum": 20,
            "minimum": 1
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "HANZI_TO_FRENCH",
                "HANZI_TO_PINYIN",
                "PINYIN_TO_HANZI",
                "MULTIPLE_CHOICE",
                "SENTENCE_TRANSLATION",
                "FILL_IN_THE_BLANK"
              ]
            },
            "maxItems": 6,
            "minItems": 0
          },
          "difficulty": {
            "type": "integer",
            "format": "int32",
            "maximum": 5,
            "minimum": 1
          },
          "strategy": {
            "type": "string",
            "enum": ["NEW", "DIFFICULT", "DUE", "RANDOM"]
          }
        },
        "required": ["strategy", "types"]
      },
      "PageResponseWordView": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/WordView" }
          },
          "number": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" }
        }
      },
      "ProgressView": {
        "type": "object",
        "properties": {
          "wordId": { "type": "string", "format": "uuid" },
          "skill": {
            "type": "string",
            "enum": [
              "HANZI_RECOGNITION",
              "HANZI_TO_PINYIN",
              "HANZI_TO_FRENCH",
              "WRITING"
            ]
          },
          "level": { "type": "integer", "format": "int32" },
          "successes": { "type": "integer", "format": "int64" },
          "errors": { "type": "integer", "format": "int64" },
          "lastReview": { "type": "string", "format": "date-time" },
          "nextReview": { "type": "string", "format": "date-time" }
        }
      },
      "Daily": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "completed": { "type": "integer", "format": "int64" },
          "due": { "type": "integer", "format": "int64" }
        }
      },
      "Overview": {
        "type": "object",
        "properties": {
          "words": { "type": "integer", "format": "int64" },
          "evaluatedSkills": { "type": "integer", "format": "int64" },
          "masteredSkills": { "type": "integer", "format": "int64" },
          "dueSkills": { "type": "integer", "format": "int64" },
          "answers": { "type": "integer", "format": "int64" },
          "successes": { "type": "integer", "format": "int64" }
        }
      },
      "ImportedReview": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "hanzi": { "type": "string", "minLength": 1 },
          "pinyin": { "type": "string", "minLength": 1 },
          "skill": {
            "type": "string",
            "enum": [
              "HANZI_RECOGNITION",
              "HANZI_TO_PINYIN",
              "HANZI_TO_FRENCH",
              "WRITING"
            ]
          },
          "correct": { "type": "boolean" },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "answer": { "type": "string", "maxLength": 2000, "minLength": 0 }
        },
        "required": [
          "answer",
          "correct",
          "hanzi",
          "id",
          "pinyin",
          "reviewedAt",
          "skill"
        ]
      },
      "Hint": {
        "type": "object",
        "properties": { "firstLetter": { "type": "string" } }
      },
      "Availability": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "HANZI_TO_FRENCH",
              "HANZI_TO_PINYIN",
              "PINYIN_TO_HANZI",
              "MULTIPLE_CHOICE",
              "SENTENCE_TRANSLATION",
              "FILL_IN_THE_BLANK"
            ]
          },
          "difficulty": { "type": "integer", "format": "int32" },
          "available": { "type": "integer", "format": "int64" }
        }
      },
      "PageResponseCorrection": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Correction" }
          },
          "number": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" }
        }
      }
    }
  }
